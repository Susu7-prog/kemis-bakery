# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are baked into the browser code at build time: set them BEFORE building.

# ---- Site -------------------------------------------------------------------
# REQUIRED in production: your public URL, e.g. https://kemis.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (REQUIRED for sign-in, checkout and orders) ---------------------
# Project Settings > API. URL and anon key are public; the service-role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth ------------------------------------------------------------
# No variables here. The Google client ID and secret are entered in the Supabase dashboard
# (Authentication > Providers > Google), never in this app. See the README.

# ---- Resend (REQUIRED for order confirmation emails, server-side only) ---------
# From address must be on a domain you have verified in Resend,
# e.g. "Kemi's Bakery <orders@yourdomain.com>"
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional but recommended: customers' replies go here and the email shows it as the contact.
RESEND_REPLY_TO_EMAIL=
# Optional, for testing or proxies only. Leave empty in production.
RESEND_API_BASE_URL=
