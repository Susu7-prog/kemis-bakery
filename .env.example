# Copy to .env.local and fill in. Never commit real values.

# Public site URL (metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. URL and anon key are public; the service-role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mailgun (order confirmation emails, server-side only)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Optional: use https://api.eu.mailgun.net for EU-region domains
MAILGUN_API_BASE_URL=
